{
  "start": false,
  "env": {
    "REGISTRY_URL": "posthog/posthog",
    "POSTHOG_APP_TAG": "latest",
    "POSTHOG_NODE_TAG": "latest",
    "DOMAIN": "product.lumen.test",
    "POSTHOG_SECRET": "${{ secret.POSTHOG_SECRET }}",
    "ENCRYPTION_SALT_KEYS": "${{ secret.ENCRYPTION_SALT_KEYS }}"
  },
  "secrets": {
    "POSTHOG_SECRET": { "length": 56, "charset": "hex" },
    "ENCRYPTION_SALT_KEYS": { "length": 32, "charset": "hex" }
  },
  "domains": [["product.lumen.test", "web", 8000]]
}
