{
  "env_files": [
    {
      "path": ".env",
      "principal": true,
      "env_vars": [
        {
          "key": "PORT",
          "value": "8080"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgres://orders:example-password@orders-db/orders"
        }
      ]
    },
    {
      "path": ".env.flatrun",
      "principal": false,
      "env_vars": [
        {
          "key": "PORT",
          "value": "8080"
        },
        {
          "key": "DATABASE_URL",
          "value": "postgres://orders:example-password@orders-db/orders"
        }
      ]
    }
  ],
  "env_vars": [
    {
      "key": "PORT",
      "value": "8080"
    },
    {
      "key": "DATABASE_URL",
      "value": "postgres://${{ orders-db.DB_USER }}:${{ orders-db.DB_PASSWORD }}@${{ orders-db.FLATRUN_HOST }}/orders"
    }
  ],
  "principal_file": ".env",
  "resolved": {
    "DATABASE_URL": "postgres://orders:example-password@orders-db/orders"
  }
}
